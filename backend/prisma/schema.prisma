datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING_OTP
  PENDING_REDIRECT
  PENDING_QR
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Category {
  id           String    @id @default(uuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  icon         String?
  bannerUrl    String?
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id              String      @id @default(uuid())
  name            String
  slug            String      @unique
  description     String
  price           Float
  originalPrice   Float
  discountPercent Int
  categorySlug    String
  category        Category    @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)
  imageUrl        String
  images          String[]    @default([])
  rating          Float       @default(4.5)
  ratingCount     Int         @default(0)
  inStock         Boolean     @default(true)
  stockQuantity   Int         @default(50)
  featured        Boolean     @default(false)
  brand           String?
  tags            String[]    @default([])
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String
  mobile    String
  address   String
  city      String
  state     String
  pincode   String
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id             String               @id @default(uuid())
  orderNumber    String               @unique
  customerId     String?
  customer       Customer?            @relation(fields: [customerId], references: [id])
  customerName   String
  customerEmail  String
  customerMobile String
  shippingAddress String
  city           String
  state          String
  pincode        String
  subtotal       Float
  discount       Float                @default(0)
  deliveryCharge Float                @default(0)
  totalAmount    Float
  status         OrderStatus          @default(PENDING)
  notes          String?
  items          OrderItem[]
  transactions   PaymentTransaction[]
  refunds        Refund[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  productName  String
  productImage String
  price        Float
  quantity     Int
  totalPrice   Float
  createdAt    DateTime @default(now())
}

model PaymentTransaction {
  id                  String           @id @default(uuid())
  orderId             String
  order               Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantTxnNo       String           @unique
  txnId               String?
  paymentId           String?
  amount              Float
  currencyCode        String           @default("356")
  paymentMode         String           // CARD, NB, WALLET, UPI, QR
  paymentOption       String?          // ICICI, HDFC, GPAY, etc.
  responseCode        String?          // 000, 0000, R1000, etc.
  responseDescription String?
  status              PaymentStatus    @default(INITIATED)
  tranCtx             String?
  redirectURI         String?
  qrData              String?
  showOTPCapturePage  String?          // Y or N
  hashVerified        Boolean          @default(false)
  rawRequest          Json?            // Masked data only
  rawResponse         Json?
  attempts            PaymentAttempt[]
  refunds             Refund[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model PaymentAttempt {
  id             String             @id @default(uuid())
  transactionId  String
  transaction    PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  attemptType    String             // INITIATE, OTP_GENERATE, OTP_VERIFY, AUTHORIZE, CALLBACK, STATUS_QUERY, REFUND, ADVICE
  requestPayload Json?
  responsePayload Json?
  statusCode     Int?
  createdAt      DateTime           @default(now())
}

model Refund {
  id                  String             @id @default(uuid())
  transactionId       String
  transaction         PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refundTxnNo         String             @unique
  amount              Float
  reason              String?
  responseCode        String?
  responseDescription String?
  status              String             @default("PENDING") // SUCCESS, FAILED, PENDING
  rawResponse         Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model PaymentCallback {
  id            String   @id @default(uuid())
  merchantTxnNo String
  payload       Json
  hashVerified  Boolean  @default(false)
  ipAddress     String?
  createdAt     DateTime @default(now())
}
